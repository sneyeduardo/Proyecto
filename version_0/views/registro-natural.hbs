<!-- ==================== CONTENIDO PRINCIPAL: REGISTRO NATURAL ==================== -->
    <main class="cg-reg-main">
        <div class="cg-container">

            <form id="cg-registro-natural-form" novalidate>

                <!-- BARRA DE TÍTULO Y ACCIONES CRUD -->
                <section class="cg-reg-banner">
                    <h1 class="cg-reg-banner__title">
                        Registro de Profesional o Técnico <span>•</span> Persona Natural
                    </h1>
                    <div class="cg-reg-banner__actions">
                        <button type="button" class="cg-act-btn cg-act-btn--white" id="btn-nuevo">Nuevo Registro</button>
                        <button type="button" class="cg-act-btn cg-act-btn--outline" id="btn-editar">Editar</button>
                        <button type="button" class="cg-act-btn cg-act-btn--red" id="btn-guardar">Guardar Cambios</button>
                        <button type="button" class="cg-act-btn cg-act-btn--muted" id="btn-eliminar">Eliminar</button>
                    </div>
                </section>

                <!-- ALERTA DE ESTADO DEMO -->
                <div id="cg-reg-alert" class="cg-reg-alert" role="alert" hidden></div>

                <!-- GRILLA DE 3 COLUMNAS -->
                <div class="cg-reg-grid">

                    <!-- ==================== COLUMNA 1: IDENTIFICACIÓN Y PERFIL ==================== -->
                    <section class="cg-reg-card">
                        <h2 class="cg-reg-card__title">Identificación y Perfil</h2>

                        <div class="cg-ident-top">
                            <!-- Sub-columna campos izquierda -->
                            <div class="cg-ident-fields">
                                <div class="cg-field-row cg-field-row--2">
                                    <div class="cg-field">
                                        <label for="tipo-doc">Tipo de Documento <span class="req">*</span></label>
                                        <select id="tipo-doc" class="cg-input" required>
                                            <option value="cedula" selected>Cédula</option>
                                            <option value="pasaporte">Pasaporte</option>
                                            <option value="dni">DNI</option>
                                            <option value="rif_natural">RIF / RUC Natural</option>
                                        </select>
                                    </div>
                                    <div class="cg-field">
                                        <label for="num-doc">Número de Documento <span class="req">*</span></label>
                                        <input type="text" id="num-doc" class="cg-input" placeholder="V-00.000.000" required>
                                    </div>
                                </div>

                                <div class="cg-field">
                                    <label>Tipo de Perfil</label>
                                    <div class="cg-segmented" data-segmented="tipo-perfil">
                                        <button type="button" class="cg-seg-btn active" data-value="Profesional">Profesional</button>
                                        <button type="button" class="cg-seg-btn" data-value="Técnico">Técnico</button>
                                    </div>
                                    <input type="hidden" id="tipo-perfil" value="Profesional">
                                </div>

                                <div class="cg-field-row cg-field-row--2">
                                    <div class="cg-field">
                                        <label for="nombres">Nombres <span class="req">*</span></label>
                                        <input type="text" id="nombres" class="cg-input" placeholder="Nombres" required>
                                    </div>
                                    <div class="cg-field">
                                        <label for="apellidos">Apellidos <span class="req">*</span></label>
                                        <input type="text" id="apellidos" class="cg-input" placeholder="Apellidos" required>
                                    </div>
                                </div>

                                <div class="cg-field-row cg-field-row--2">
                                    <div class="cg-field">
                                        <label for="fecha-nac">Fecha de Nacimiento <span class="req">*</span></label>
                                        <input type="date" id="fecha-nac" class="cg-input" required>
                                    </div>
                                    <div class="cg-field">
                                        <label for="correo-perfil">Correo Electrónico <span class="req">*</span></label>
                                        <input type="email" id="correo-perfil" class="cg-input" placeholder="correo@ejemplo.com" required>
                                    </div>
                                </div>
                            </div>

                            <!-- Sub-columna Foto de Perfil -->
                            <div class="cg-photo-col">
                                <label class="cg-photo-label">Foto de Perfil profesional<br><span>(Opcional)</span></label>
                                <label class="cg-upload-box cg-upload-box--profile" for="foto-perfil-input">
                                    <input type="file" id="foto-perfil-input" accept=".jpg,.jpeg,.png" hidden>
                                    <img id="foto-perfil-preview" class="cg-upload-preview" alt="Vista previa" hidden>
                                    <div class="cg-upload-placeholder" id="foto-perfil-placeholder">
                                        <i class="fa fa-camera"></i>
                                        <span>Subir foto<br>(.jpg, .png)</span>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <!-- Contraseña -->
                        <div class="cg-field">
                            <label for="password-natural">Contraseña de acceso <span class="req">*</span></label>
                            <div class="cg-password-wrap">
                                <input type="password" id="password-natural" class="cg-input" placeholder="Contraseña segura (mín. 8 caracteres)" required>
                                <button type="button" class="cg-eye-btn" id="toggle-pass-btn" aria-label="Mostrar u ocultar contraseña">
                                    <i class="fa fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Teléfonos -->
                        <div class="cg-field-row cg-field-row--2">
                            <div class="cg-field">
                                <label for="tel-movil">Teléfono Móvil <span class="req">*</span></label>
                                <input type="tel" id="tel-movil" class="cg-input" placeholder="+58 412 000 0000" required>
                            </div>
                            <div class="cg-field">
                                <label for="tel-fijo">Teléfono Fijo</label>
                                <input type="tel" id="tel-fijo" class="cg-input" placeholder="+58 212 000 0000">
                            </div>
                        </div>

                        <!-- Biografía -->
                        <div class="cg-field cg-field--grow">
                            <label for="biografia">Biografía / Resumen <span class="req">*</span></label>
                            <textarea id="biografia" class="cg-input cg-textarea" rows="5" placeholder="Describe tu experiencia en obra, proyectos destacados y servicios que ofreces..." required></textarea>
                        </div>
                    </section>

                    <!-- ==================== COLUMNA 2: ESPECIALIDAD Y TRAYECTORIA ==================== -->
                    <section class="cg-reg-card">
                        <h2 class="cg-reg-card__title">Especialidad y Trayectoria</h2>

                        <div class="cg-field">
                            <label for="cat-principal">Categoría principal</label>
                            <select id="cat-principal" class="cg-input">
                                <option value="ingenieria-civil">Ingeniería Civil</option>
                                <option value="arquitectura">Arquitectura y Diseño</option>
                                <option value="electricidad">Ingeniería Eléctrica / Técnico</option>
                                <option value="mecanica">Climatización y Mecánica</option>
                                <option value="obra-gris">Construcción y Obra Gris</option>
                            </select>
                        </div>

                        <div class="cg-field-row cg-field-row--2">
                            <div class="cg-field">
                                <label for="subesp-1">Subespecialidad 1</label>
                                <select id="subesp-1" class="cg-input">
                                    <option value="">Seleccionar...</option>
                                    <option value="estructuras">Estructuras</option>
                                    <option value="vialidad">Vialidad</option>
                                    <option value="hidraulica">Hidráulica</option>
                                    <option value="acabados">Acabados</option>
                                </select>
                            </div>
                            <div class="cg-field">
                                <label for="subesp-2">Subespecialidad 2</label>
                                <select id="subesp-2" class="cg-input">
                                    <option value="">Seleccionar...</option>
                                    <option value="calculo">Cálculo Estructural</option>
                                    <option value="inspeccion">Inspección de Obra</option>
                                    <option value="presupuestos">Presupuestos y Valuaciones</option>
                                    <option value="remodelacion">Remodelaciones</option>
                                </select>
                            </div>
                        </div>

                        <div class="cg-field">
                            <label for="profesion-principal">Profesión o Especialidad Principal</label>
                            <select id="profesion-principal" class="cg-input">
                                <option value="ing-civil-estructuras" selected>Ingeniero Civil - Estructuras y Cálculo</option>
                                <option value="arquitecto">Arquitecto - Diseño y Proyectos</option>
                                <option value="ing-electrico">Ingeniero Eléctrico - Baja y Alta Tensión</option>
                                <option value="tsu-construccion">TSU en Construcción Civil</option>
                                <option value="maestro-obra">Maestro de Obra Certificado</option>
                            </select>
                        </div>

                        <div class="cg-field">
                            <label for="anios-exp">Años de experiencia en construcción <span class="req">*</span></label>
                            <input type="number" id="anios-exp" class="cg-input" min="0" max="60" placeholder="Ej. 8" required>
                        </div>

                        <div class="cg-field">
                            <label for="num-civ">ID / Número de colegiatura (CIV/Licencia) <span class="req">*</span></label>
                            <input type="text" id="num-civ" class="cg-input" placeholder="Ej. CIV 245.890" required>
                        </div>

                        <div class="cg-field">
                            <label>Estado de vinculación</label>
                            <div class="cg-segmented cg-segmented--3" data-segmented="estado-vinculacion">
                                <button type="button" class="cg-seg-btn active" data-value="Independiente">Independiente</button>
                                <button type="button" class="cg-seg-btn" data-value="Vinculado a Empresa">Vinculado</button>
                                <button type="button" class="cg-seg-btn" data-value="Ambos">Ambos</button>
                            </div>
                            <input type="hidden" id="estado-vinculacion" value="Independiente">
                        </div>

                        <div class="cg-field-row cg-field-row--2">
                            <div class="cg-field">
                                <input type="text" id="empresa-labora" class="cg-input" placeholder="Empresa donde labora">
                            </div>
                            <div class="cg-field">
                                <input type="text" id="cargo-rol" class="cg-input" placeholder="Cargo o Rol">
                            </div>
                        </div>

                        <div class="cg-field-row cg-field-row--2 cg-align-center">
                            <div class="cg-field">
                                <label for="modalidad">Modalidad de servicios <span class="req">*</span></label>
                                <select id="modalidad" class="cg-input" required>
                                    <option value="presencial">Presencial / En Obra</option>
                                    <option value="remoto">Remoto / Planos</option>
                                    <option value="hibrido" selected>Híbrido</option>
                                    <option value="consultoria">Consultoría Técnica</option>
                                </select>
                            </div>
                            <div class="cg-field">
                                <label for="disponibilidad">Disponibilidad actual <span class="req">*</span></label>
                                <div class="cg-switch-row">
                                    <label class="cg-switch">
                                        <input type="checkbox" id="disponibilidad" checked>
                                        <span class="cg-switch__slider"></span>
                                    </label>
                                    <span class="cg-switch-text" id="disponibilidad-label">Disponible</span>
                                </div>
                            </div>
                        </div>

                        <div class="cg-field">
                            <label for="tag-input">Tags SEO (prefijo #) <span class="req">*</span></label>
                            <div class="cg-tags-box" id="cg-tags-box">
                                <span class="cg-seo-tag">#IngenieriaCivil <button type="button" aria-label="Quitar">&times;</button></span>
                                <span class="cg-seo-tag">#Estructuras <button type="button" aria-label="Quitar">&times;</button></span>
                                <span class="cg-seo-tag">#ObraGris <button type="button" aria-label="Quitar">&times;</button></span>
                                <input type="text" id="tag-input" class="cg-tags-input" placeholder="Añadir #tag + Enter">
                            </div>
                        </div>
                    </section>

                    <!-- ==================== COLUMNA 3: UBICACIÓN, CONTACTO Y PORTAFOLIO ==================== -->
                    <section class="cg-reg-card">
                        <h2 class="cg-reg-card__title">Ubicación y Contacto</h2>

                        <div class="cg-field-row cg-field-row--2">
                            <div class="cg-field">
                                <label for="pais">País <span class="req">*</span></label>
                                <select id="pais" class="cg-input" required>
                                    <option value="Venezuela" selected>Venezuela</option>
                                    <option value="Colombia">Colombia</option>
                                    <option value="Panama">Panamá</option>
                                </select>
                            </div>
                            <div class="cg-field">
                                <label for="estado">Estado / Región <span class="req">*</span></label>
                                <select id="estado" class="cg-input" required>
                                    <option value="">Seleccionar...</option>
                                    <option value="Distrito Capital" selected>Distrito Capital</option>
                                    <option value="Miranda">Miranda</option>
                                    <option value="Carabobo">Carabobo</option>
                                    <option value="Zulia">Zulia</option>
                                    <option value="Bolivar">Bolívar</option>
                                    <option value="Lara">Lara</option>
                                </select>
                            </div>
                        </div>

                        <div class="cg-field">
                            <label for="ciudad-municipio">Ciudad / Municipio <span class="req">*</span></label>
                            <select id="ciudad-municipio" class="cg-input" required>
                                <option value="solo-ciudad" selected>Zonas de cobertura (Solo su ciudad)</option>
                                <option value="chacao">Caracas - Chacao</option>
                                <option value="baruta">Caracas - Baruta</option>
                                <option value="sucre">Caracas - Sucre</option>
                                <option value="libertador">Caracas - Libertador</option>
                                <option value="nacional">Cobertura Nacional</option>
                            </select>
                        </div>

                        <div class="cg-field">
                            <label for="direccion">Dirección comercial o de oficina</label>
                            <input type="text" id="direccion" class="cg-input" placeholder="Av. Principal, Edif. / Oficina...">
                        </div>

                        <div class="cg-field">
                            <label>Preferencia de contacto</label>
                            <div class="cg-segmented cg-segmented--4" data-segmented="pref-contacto">
                                <button type="button" class="cg-seg-btn active" data-value="WhatsApp">WhatsApp</button>
                                <button type="button" class="cg-seg-btn" data-value="Llamada">Llamada</button>
                                <button type="button" class="cg-seg-btn" data-value="Correo">Correo</button>
                                <button type="button" class="cg-seg-btn" data-value="Formulario">Formulario</button>
                            </div>
                            <input type="hidden" id="pref-contacto" value="WhatsApp">
                        </div>

                        <!-- Redes sociales interactivas -->
                        <div class="cg-socials-strip">
                            <button type="button" class="cg-social-chip" data-social="instagram">
                                <i class="fa fa-instagram"></i> Instagram
                            </button>
                            <button type="button" class="cg-social-chip" data-social="tiktok">
                                <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298 0 .593.046.875.138V9.4a6.34 6.34 0 0 0-1-.08A6.34 6.34 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.04-.1z"/></svg>
                                TikTok
                            </button>
                            <button type="button" class="cg-social-chip" data-social="youtube">
                                <i class="fa fa-youtube-play"></i> YouTube
                            </button>
                            <button type="button" class="cg-social-chip" data-social="linkedin">
                                <i class="fa fa-linkedin-square"></i> LinkedIn
                            </button>
                        </div>
                        <div class="cg-social-input-wrap" id="cg-social-input-wrap" hidden>
                            <input type="url" id="cg-social-url" class="cg-input" placeholder="https://instagram.com/tuusuario">
                        </div>

                        <hr class="cg-divider">

                        <!-- PORTAFOLIO DE OBRAS -->
                        <h3 class="cg-reg-card__subtitle">Portafolio de Obras <span>(Antes / Después)</span></h3>

                        <!-- Proyecto 1 -->
                        <div class="cg-project-block">
                            <label for="proy-1-titulo">Proyecto 1 <span class="req">*</span></label>
                            <div class="cg-project-row">
                                <input type="text" id="proy-1-titulo" class="cg-input" placeholder="Título del proyecto" required>
                                <label class="cg-mini-upload" for="proy-1-antes">
                                    <input type="file" id="proy-1-antes" accept=".jpg,.jpeg,.png" hidden>
                                    <img class="cg-mini-preview" alt="Antes" hidden>
                                    <span class="cg-mini-placeholder"><i class="fa fa-camera"></i><span>Foto Antes</span></span>
                                </label>
                                <label class="cg-mini-upload" for="proy-1-despues">
                                    <input type="file" id="proy-1-despues" accept=".jpg,.jpeg,.png" hidden>
                                    <img class="cg-mini-preview" alt="Después" hidden>
                                    <span class="cg-mini-placeholder"><i class="fa fa-camera"></i><span>Foto Después</span></span>
                                </label>
                            </div>
                        </div>

                        <!-- Proyecto 2 -->
                        <div class="cg-project-block">
                            <label for="proy-2-titulo">Proyecto 2 <span class="req">*</span></label>
                            <div class="cg-project-row">
                                <input type="text" id="proy-2-titulo" class="cg-input" placeholder="Título del proyecto">
                                <label class="cg-mini-upload" for="proy-2-antes">
                                    <input type="file" id="proy-2-antes" accept=".jpg,.jpeg,.png" hidden>
                                    <img class="cg-mini-preview" alt="Antes" hidden>
                                    <span class="cg-mini-placeholder"><i class="fa fa-camera"></i><span>Foto Antes</span></span>
                                </label>
                                <label class="cg-mini-upload" for="proy-2-despues">
                                    <input type="file" id="proy-2-despues" accept=".jpg,.jpeg,.png" hidden>
                                    <img class="cg-mini-preview" alt="Después" hidden>
                                    <span class="cg-mini-placeholder"><i class="fa fa-camera"></i><span>Foto Después</span></span>
                                </label>
                            </div>
                        </div>

                        <!-- Aceptación de términos -->
                        <label class="cg-terms-check" for="acepta-terminos">
                            <input type="checkbox" id="acepta-terminos" required>
                            <span>Aceptación de términos, veracidad de la información y privacidad <strong>(Obligatorio)</strong></span>
                        </label>

                        <!-- Botón CTA principal -->
                        <button type="submit" class="cg-reg-submit">Registrar y Publicar Perfil</button>
                    </section>

                </div>
            </form>
        </div>
    </main>
